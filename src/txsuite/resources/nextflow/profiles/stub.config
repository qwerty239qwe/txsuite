// Resource sizing for stub runs.
//
// A stub run exercises DAG wiring, not the tools, but Nextflow validates a
// task's resource request against the machine before executing anything. The
// real labels ask for what alignment and indexing genuinely need -- 16 GB for
// salmon, 32 GB for STAR -- which no CI runner has, so every stub task would be
// rejected at submission. Shrink every request to something any runner can
// satisfy; the stub scripts only write small placeholder files.
process {
    cpus = 1
    memory = '1 GB'

    withLabel: salmon {
        cpus = 1
        memory = '1 GB'
    }
    withLabel: star {
        cpus = 1
        memory = '1 GB'
    }
    withLabel: single_cell {
        cpus = 1
        memory = '1 GB'
    }
    withLabel: bulk_r {
        cpus = 1
        memory = '1 GB'
    }
    withLabel: cellranger {
        cpus = 1
        memory = '1 GB'
    }
}
