manifest {
    name = 'txsuite/native-workflows'
    version = '0.1.0'
    nextflowVersion = '>=25.10.0'
}

params {
    // single-cell.pseudobulk-de
    input = null
    outdir = 'results/pseudobulk-de'
    sample_column = 'sample'
    design = 'condition'
    reference = 'control'
    test = 'treated'
    single_cell_image = null
    bulk_image = null
    padj = 0.05
    lfc = 1.0
    top_genes = 50

    // single-cell.cellranger
    genome_name = null
    fasta = null
    gtf = null
    cellranger_reference = null
    fastqs = null
    sample = null
    cellranger_image = null
    cellranger_threads = 4
    cellranger_memory_gb = 8
    cellranger_create_bam = 'true'
}

process.shell = ['/bin/bash', '-ue']

profiles {
    local {
        includeConfig 'profiles/local.config'
    }
    docker {
        includeConfig 'profiles/docker.config'
    }
    apptainer {
        includeConfig 'profiles/apptainer.config'
    }
}
