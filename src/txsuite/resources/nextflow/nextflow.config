manifest {
    name = 'txsuite/native-workflows'
    version = '0.2.0'
    nextflowVersion = '>=25.10.0'
}

params {
    // single-cell.pseudobulk-de
    input = null
    manifest = null
    outdir = 'results/pseudobulk-de'
    comparison = null
    sample_column = 'sample'
    design = 'condition'
    group_column = null
    group_value = null
    covariates = ''
    reference = 'control'
    test = 'treated'
    method = 'deseq2'
    single_cell_image = null
    bulk_image = null
    padj = 0.05
    lfc = 1.0
    top_genes = 50

    // single-cell.cellranger
    genome_name = null
    fasta = null
    gtf = null
    cellranger_reference = null
    fastqs = null
    sample = null
    cellranger_image = null
    cellranger_threads = 4
    cellranger_memory_gb = 8
    cellranger_create_bam = 'true'

    // bulk.salmon and single-cell.alevin (--fasta/--gtf are shared with the
    // Cell Ranger DAG above)
    samplesheet = null
    salmon_image = null
    salmon_index = null
    tx2gene = null
    salmon_libtype = 'A'
    salmon_kmer_len = 31
    salmon_gencode = false
    simpleaf_index = null
    simpleaf_rlen = 91
    alevin_chemistry = '10xv3'
    alevin_resolution = 'cr-like'
    alevin_whitelist = null
}

process {
    shell = ['/bin/bash', '-ue']
    publishDir = [path: params.outdir, mode: 'copy', overwrite: true]

    withLabel: single_cell {
        container = params.single_cell_image
        cpus = 2
        memory = '6 GB'
    }
    withLabel: bulk_r {
        container = params.bulk_image
        cpus = 2
        memory = '6 GB'
    }
    withLabel: salmon {
        container = params.salmon_image
        cpus = 4
        memory = '16 GB'
    }
    withName: 'PSEUDOBULK|BULK_DE' {
        errorStrategy = 'ignore'
    }
}

workflow.failOnIgnore = true

profiles {
    local { includeConfig 'profiles/local.config' }
    docker { includeConfig 'profiles/docker.config' }
    apptainer { includeConfig 'profiles/apptainer.config' }
}
